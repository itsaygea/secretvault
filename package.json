{
  "name": "secretvault",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "secretvault": "./bin/secretvault-mcp.js",
    "secretvault-cli": "./bin/secretvault-mcp.js",
    "secretvault-mcp": "./bin/secretvault-mcp.js"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "clean": "rm -rf packages/*/dist",
    "prebuild": "npm run clean",
    "build": "(cd packages/testing && npm run build) && (cd packages/shared && npm run build) && (cd packages/client && npm run build) && (cd packages/admin && npm run build) && (cd packages/bridge && npm run build) && (cd packages/sdk && npm run build) && (cd packages/mcp-server && npm run build)",
    "check:build-reproducibility": "node scripts/check-build-reproducibility.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "prepare": "npm run build",
    "dev:mcp": "tsx packages/mcp-server/src/index.ts",

    "deploy": "bash scripts/deploy.sh",
    "test": "node --import tsx --test --test-reporter=spec 'packages/*/src/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@secretvault/shared": "file:packages/shared",
    "@simplewebauthn/server": "^13.1.2",

    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "express": "^5.2.1",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {

    "typescript": "^5.5.0",
    "@secretvault/testing": "file:packages/testing",
    "tsx": "^4.16.0",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
