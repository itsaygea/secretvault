# ── SecretVault Master Key (CRITICAL: MUST BE BACKED UP) ──────────────
# Generate a random 64-char hex key using: openssl rand -hex 32
# WARNING: If this key is lost, all encrypted secrets become permanently unrecoverable!
SECRETVAULT_MASTER_KEY=

# Alternatively, specify file path for Docker/Kubernetes Secrets (tmpfs RAM mount):
# SECRETVAULT_MASTER_KEY_FILE=/run/secrets/master_key

# ── Supabase Backend Connectivity ─────────────────────────────────────
# URL to your Supabase project (Cloud or Self-Hosted)
SECRETVAULT_SUPABASE_URL=https://supabase.example.com
# Supabase Service Role Key (with schema administrative permissions)
SECRETVAULT_SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# SV-AUD-013: PostgREST JWT secret (the HMAC secret behind the service key). The
# app needs the raw secret to mint short-lived, internal-only per-request tenant
# JWTs so the database (not the application filter) enforces tenant isolation via
# RLS. For Supabase Cloud this is the JWT secret from Settings > API. For the
# bundled stack install-server.sh generates it as PGRST_JWT_SECRET.
SECRETVAULT_PGRST_JWT_SECRET=
# Direct PostgreSQL URL used by the startup migration runner (migrate.ts)
# NOTE: Direct connection string to your PostgreSQL instance (e.g. port 5432 or custom HA port)
SECRETVAULT_DATABASE_URL=postgresql://supabase_admin:your_password@db.example.com:5432/postgres

# ── Database TLS (SV-021) ─────────────────────────────────────────────
# TLS is ON with certificate verification ON by default. Override only when
# you understand the trade-off:
#   SECRETVAULT_DATABASE_SSL=false               → disable TLS entirely (plaintext)
#   SECRETVAULT_DATABASE_SSL_CA_FILE=/path/ca.pem → pin a CA bundle (recommended)
#   SECRETVAULT_DATABASE_SSL_CA=<inline PEM>      → pin a CA bundle (inline)
#   SECRETVAULT_DATABASE_SSL_SERVERNAME=pg.internal → override SNI / hostname check
# Dev-only verification bypass — requires BOTH keys; never use on untrusted networks:
#   SECRETVAULT_DATABASE_SSL_INSECURE=1
#   SECRETVAULT_DATABASE_SSL_INSECURE_CONFIRM=I-know-this-is-insecure
# For a local PostgreSQL instance without TLS, uncomment:
# SECRETVAULT_DATABASE_SSL=false

# ── Bundled PostgreSQL (zero-dependency 1-click mode, #93) ───────────
# Skip everything above and run a self-contained postgres:16-alpine next to
# SecretVault via the bundled overlay:
#   docker compose -f docker-compose.yml -f docker-compose.bundled.yml up -d
# The overlay wires SECRETVAULT_DATABASE_URL + SECRETVAULT_DATABASE_SSL=false
# to this local container automatically; you only need to set the credentials
# below (install-server.sh #94 generates strong random values for you).
# NOTE: the runtime server still talks to its backend through the Supabase REST
# API (SECRETVAULT_SUPABASE_URL). A bare postgres container satisfies the
# startup migration runner but is not a Supabase/PostgREST instance.
POSTGRES_DB=secretvault
POSTGRES_USER=secretvault
POSTGRES_PASSWORD=

# Existing installations migrated manually may set this once, e.g. 011_audit_event_contract
# SECRETVAULT_MIGRATIONS_BASELINE=011_audit_event_contract

# ── Admin Bootstrap Password ──────────────────────────────────────────
# Used ONLY on first boot to create the initial 'admin' user account.
SECRETVAULT_UI_PASSWORD=ChangeMeOnFirstBoot123!

# ── Transport / TLS (SV-020 / SV-AUD-001) ─────────────────────────────
# SecretVault must sit behind a TLS-terminating reverse proxy in production
# (Caddy, Nginx Proxy Manager, Tailscale Serve — see docs/install.md).
#
# Two addresses govern exposure:
#   - SECRETVAULT_BIND_HOST   : interface the Node listener binds to INSIDE its
#                               runtime. Default 127.0.0.1; the published image
#                               sets 0.0.0.0 so a proxy on the Compose network
#                               can reach it. This bind is container-internal
#                               and does NOT by itself expose plaintext.
#   - SECRETVAULT_PUBLISH_HOST: HOST-side address port 3004 is published on
#                               (the Compose `ports:` left side). Default
#                               127.0.0.1 (loopback). This is what determines
#                               whether plaintext is externally reachable.
# Interface the Node listener binds to (default 127.0.0.1; 0.0.0.0 in the image):
# SECRETVAULT_BIND_HOST=127.0.0.1
# Host-side publish address for port 3004 (default 127.0.0.1 = loopback only):
# SECRETVAULT_PUBLISH_HOST=127.0.0.1
# Native TLS termination (alternative to a reverse proxy):
# SECRETVAULT_TLS_CERT=/path/to/fullchain.pem
# SECRETVAULT_TLS_KEY=/path/to/privkey.pem
# Production plaintext refusal bypass — requires BOTH keys AND a non-loopback
# SECRETVAULT_PUBLISH_HOST; only safe behind a TLS-terminating proxy on a
# trusted network. The runtime guard refuses to start plaintext on a non-loopback
# publish address unless these are set:
# SECRETVAULT_ALLOW_PLAINTEXT_EXTERNAL=1
# SECRETVAULT_ALLOW_PLAINTEXT_EXTERNAL_CONFIRM=I-know-this-is-insecure

# ── CORS Allowlist ────────────────────────────────────────────────────
# Comma-separated origins allowed to access REST API / Web UI. Use the final
# HTTPS URL(s) users reach the UI through (e.g. behind your reverse proxy).
SECRETVAULT_ALLOWED_ORIGINS=https://vault.example.com

# ── Proxy Destination Allowlist (Optional but required for non-admin profiles)
# Comma-separated exact upstream origins, e.g.
# SECRETVAULT_EGRESS_ALLOWLIST=https://api.github.com,https://api.openai.com
SECRETVAULT_EGRESS_ALLOWLIST=

# ── Proxy Upstream Timeout (Optional) ─────────────────────────────────
# Milliseconds before an upstream connection is aborted (default: 30000)
SECRETVAULT_PROXY_TIMEOUT_MS=30000

# ── Trusted Proxy & Authentication Rate Limits (Optional) ─────────────
# SV-AUD-011: who is allowed to set the client IP via forwarding headers, and
# how tightly authentication attempts are bounded. Both default to safe values;
# set them only to match your deployment.

# Comma-separated list of CIDR ranges or single addresses of reverse proxies
# (Caddy/Nginx/Cloudflare) in front of SecretVault. When the immediate TCP peer
# matches one of these, X-Forwarded-For / X-Real-IP / CF-Connecting-IP is honored.
# Empty (default) = trust NO header: a direct client can never rotate its
# rate-limit identity by spoofing X-Forwarded-For.
# Example: SECRETVAULT_TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12,::ffff:172.16.0.0/12
SECRETVAULT_TRUSTED_PROXIES=

# Fixed-window length (ms) shared by all auth rate limits (default: 60000).
SECRETVAULT_RATE_LIMIT_WINDOW_MS=60000
# Max attempts per window per identity+IP for each surface. Defaults bound bcrypt
# work (login/register/setup) and the TOTP/backup-code guessing surface.
SECRETVAULT_RATE_LIMIT_MAX_LOGIN=10
SECRETVAULT_RATE_LIMIT_MAX_REGISTER=5
SECRETVAULT_RATE_LIMIT_MAX_TOTP=5

